# ─────────────────────────────────────────────────────────────────────
# Z0tz landing — environment template
# ─────────────────────────────────────────────────────────────────────
# Copy to `.env.local` for local development (gitignored).
# For production, paste the same set into the Vercel dashboard
# (Project Settings → Environment Variables → Production).
#
# Two generations live on this landing:
#   - V6.5 — frozen, tagged v6.5-stable. Routes at top-level /api/*.
#   - V7   — active development. Routes at /api/v7/*.
# Both share the same RELAYER_PRIVATE_KEY (one deployer per chain).
# ─────────────────────────────────────────────────────────────────────


# ═══════════════════════════════════════════════════════════════════
# 1. Shared: relayer key + EntryPoint + chain allowlist
# ═══════════════════════════════════════════════════════════════════

# 0x-prefixed hex private key. Funds gas + cosigns paymaster envelopes.
# For local dev you can use Hardhat account #0
# (0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80).
# For production set the Z0tz operator's key via Vercel.
RELAYER_PRIVATE_KEY=0x...

# ERC-4337 EntryPoint v0.8 — same address on every chain.
ENTRYPOINT_ADDRESS=0x4337084D9E255Ff0702461CF8895CE9E3b5Ff108

# Comma-separated chainIds the landing will accept.
# 31337     = local hardhat
# 11155111  = eth-sepolia
# 421614    = arb-sepolia
# 84532     = base-sepolia
ALLOWED_CHAINS=31337,11155111,421614,84532


# ═══════════════════════════════════════════════════════════════════
# 2. V7 — RPC URLs + per-chain deployment blobs
# ═══════════════════════════════════════════════════════════════════
#
# RPC_URL_<chainId>     — chain endpoint, used by relayer + indexer.
# DEPLOYMENT_V7_<chainId> — JSON blob mirroring the `deployment` field
#                          of contracts-v7/deployments/<network>.json.
# After each `pnpm deploy:<network>` run, paste the resulting JSON.

# Local hardhat (no Turso needed; uses file:./local.db by default)
RPC_URL_31337=http://127.0.0.1:8545
DEPLOYMENT_V7_31337={"accountFactory":"0x...","recoveryHub":"0x...","...":"..."}

# Arbitrum Sepolia
RPC_URL_421614=https://arbitrum-sepolia.infura.io/v3/<your-infura-key>
DEPLOYMENT_V7_421614={"accountFactory":"0x...","...":"..."}

# Base Sepolia
RPC_URL_84532=https://base-sepolia.infura.io/v3/<your-infura-key>
DEPLOYMENT_V7_84532={"accountFactory":"0x...","...":"..."}

# Eth Sepolia
RPC_URL_11155111=https://eth-sepolia.g.alchemy.com/v2/<your-alchemy-key>
DEPLOYMENT_V7_11155111={"accountFactory":"0x...","...":"..."}


# ═══════════════════════════════════════════════════════════════════
# 3. V7 — Turso (libsql) for indexer + org_keys + recovery cache
# ═══════════════════════════════════════════════════════════════════
#
# ONE database covers all chains (every V7 table has a chain_id column).
# For production: provision at https://turso.tech, get the libsql:// URL
# and an auth token via `turso db tokens create z0tz-v7-...`
# For local dev: leave as file:./local.db (no Turso account needed).

TURSO_V7_DATABASE_URL=libsql://z0tz-v7-testnet-<org>.turso.io
TURSO_V7_AUTH_TOKEN=<paste-from-turso-CLI>

# Optional: V6.5 uses a separate DB (kept frozen).
# TURSO_DATABASE_URL=libsql://z0tz-v65-...
# TURSO_AUTH_TOKEN=...


# ═══════════════════════════════════════════════════════════════════
# 4. V7 — paymaster cosign policy
# ═══════════════════════════════════════════════════════════════════
#
# Hard caps the cosign endpoint enforces. Defaults are safe for testnet.

# Max wei the operator will sponsor in any single UserOp.
# Default = 1 ETH = 1e18 wei. Set lower if you want a tighter ceiling.
Z0TZ_PAYMASTER_MAX_FEE_CAP=1000000000000000000

# Max validity window for a single cosign sig (seconds).
# Default 600 (10 min). Don't set high — long-lived cosigns get
# exploited by replay.
Z0TZ_PAYMASTER_MAX_VALIDITY=600


# ═══════════════════════════════════════════════════════════════════
# 5. V7 — abuse / geo / audit-log
# ═══════════════════════════════════════════════════════════════════

# Geo-block the regions Z0tz is not licensed to serve. Set "true" in
# production; "false" or unset on dev so local IPs aren't blocked.
GEOFENCE_ENABLED=true

# Random 32-character salt used to hash IPs before logging. Rotate
# per environment so dev/staging/prod logs can't be cross-correlated.
Z0TZ_IP_HASH_SALT=<random-32-hex-chars>


# ═══════════════════════════════════════════════════════════════════
# 6. V6.5 — frozen addresses (DO NOT change; tag v6.5-stable depends on these)
# ═══════════════════════════════════════════════════════════════════

# Base Sepolia (84532)
PAYMASTER_ADDRESS_84532=0xd32aD7E3D879458963762B432edEc4D04E77A976
FACTORY_ADDRESS_84532=0x01E543EF0dC63328Ef59250dA4cBc717BBf7bAb3
TOKEN_ADDRESS_84532=0x73D9e7800A85E3935ae36B1A57c715D7379886C7
BRIDGE_ADDRESS_84532=0xA1df4ED5ce42444df41Ff6AF0AcCccD804851Ee9

# Eth Sepolia (11155111)
PAYMASTER_ADDRESS_11155111=0xfB2Fa879726c9e1101497D4F9B34BdD1ec0c8702
FACTORY_ADDRESS_11155111=0xE6eD73e9dB832bFd7e80432E36A4b187999EC3F7
TOKEN_ADDRESS_11155111=0x9778E6C26a3d6Af81E44AC1e54C29241967bea16
BRIDGE_ADDRESS_11155111=0x13Feee76C95060Ca80b3c049243446460154F052

# Arb Sepolia (421614)
PAYMASTER_ADDRESS_421614=0x4B038D34809363174a6Fc44715CE8Aafc1f9c55d
FACTORY_ADDRESS_421614=0xdC2C1240688D7Ec45B91662541D3a1E249a06359
TOKEN_ADDRESS_421614=0x172b17c101E5cF692a2586E976450B96AD32c292
BRIDGE_ADDRESS_421614=0xB39452806FC3658b78b06880e89F86980B56C08D


# ═══════════════════════════════════════════════════════════════════
# 7. Rate limiting (applies to both V6.5 and V7 submit endpoints)
# ═══════════════════════════════════════════════════════════════════

MAX_OPS_PER_MINUTE=60


# ═══════════════════════════════════════════════════════════════════
# Vercel deployment notes
# ═══════════════════════════════════════════════════════════════════
#
# Set every variable above EXCEPT the V6.5 addresses (those have static
# fallbacks in code) and `DEPLOYMENT_V7_31337` (local only) in the Vercel
# dashboard under:
#
#   Project → Settings → Environment Variables → Production
#
# Mark RELAYER_PRIVATE_KEY and TURSO_V7_AUTH_TOKEN as "Sensitive" so
# they're encrypted at rest and not visible in deploy logs.
#
# The `vercel.json` at the project root configures three crons hitting
# /api/v7/scan?chainId=… every 10 minutes as the inbound-stealth fallback;
# active users trigger /api/v7/scan themselves before reading history
# (matching the V6.5 indexer pattern).
