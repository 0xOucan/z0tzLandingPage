# ═══════════════════════════════════════════════════════════════════════
# Z0tz landing — environment template (V6.5 + V7 unified)
# ═══════════════════════════════════════════════════════════════════════
#
# Copy to `.env.local` for local development (gitignored).
# For production: paste into Vercel dashboard → Settings → Environment
# Variables → Production (mark secret-bearing entries "Sensitive").
#
# Two generations run on the same landing in parallel:
#   - V6.5  frozen, tagged v6.5-stable. Routes at top-level /api/*.
#   - V7    active development. Routes at /api/v7/*.
#
# Shared: RELAYER_PRIVATE_KEY (one deployer per chain), RPC_URL_<id>,
#         ENTRYPOINT_ADDRESS, ALLOWED_CHAINS.
# Per-generation: every per-chain contract address (V6.5) vs a single
#         DEPLOYMENT_V7_<id> JSON blob (V7, since the V7 deployment
#         contains 22+ addresses per chain — JSON keeps it readable).
# ═══════════════════════════════════════════════════════════════════════


# ═══ 1. Shared: signer + EntryPoint + chain allowlist ═══════════════════

# 0x-prefixed hex private key. Funds gas, signs every relayed tx,
# cosigns paymaster sponsorship envelopes for V7.
# Local dev:  Hardhat account #0
#             (0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80)
# Production: real Z0tz operator key. Mark Sensitive in Vercel.
RELAYER_PRIVATE_KEY=0x...

# ERC-4337 EntryPoint v0.8 — same address on every chain.
ENTRYPOINT_ADDRESS=0x4337084D9E255Ff0702461CF8895CE9E3b5Ff108

# Comma-separated chainIds the landing will accept.
# 31337     local hardhat
# 11155111  eth-sepolia
# 421614    arb-sepolia
# 84532     base-sepolia
ALLOWED_CHAINS=31337,11155111,421614,84532

# Bypass token for trusted internal callers (volumebot, GUI dev builds,
# stress tests). Leave empty in production unless you actually use it.
RELAYER_BYPASS_TOKEN=


# ═══ 2. RPC URLs (shared by V6.5 + V7) ══════════════════════════════════

RPC_URL_31337=http://127.0.0.1:8545
RPC_URL_421614=https://arbitrum-sepolia.infura.io/v3/<your-key>
RPC_URL_84532=https://base-sepolia.infura.io/v3/<your-key>
RPC_URL_11155111=https://eth-sepolia.g.alchemy.com/v2/<your-key>


# ═══ 3. V7 per-chain — deployment JSON blob ═════════════════════════════
#
# After `pnpm deploy:<network>` writes deployments/<network>.json,
# copy the `deployment` field as a single-line JSON string here.
# Helper one-liner (run from contracts-v7/):
#   for c in 421614:arb-sepolia 84532:base-sepolia 11155111:eth-sepolia; do
#     id=${c%:*}; net=${c#*:}
#     echo "DEPLOYMENT_V7_$id=$(jq -c .deployment deployments/$net.json)"
#   done

DEPLOYMENT_V7_31337={"accountFactory":"0x...","recoveryHub":"0x...","...":"..."}
DEPLOYMENT_V7_421614={"accountFactory":"0x...","...":"..."}
DEPLOYMENT_V7_84532={"accountFactory":"0x...","...":"..."}
DEPLOYMENT_V7_11155111={"accountFactory":"0x...","...":"..."}


# ═══ 3b. V7 Tezcatli DeFi ═══════════════════════════════════════════════
#
# The Tezcatli vault + Aave V3 adapter addresses are populated AUTOMATICALLY
# by the V7 deploy script — they land in `contracts-v7/deployments/<network>.json`
# under `deployment.tezcatliVault` / `deployment.tezcatliAdapter` (and in
# `verifyRegistry` for Etherscan verification). The DEPLOYMENT_V7_<chainId>
# JSON blob in section 3 already carries them; the per-chain template lines
# below are optional convenience overrides (e.g. to point a single landing
# at a different Tezcatli deployment without re-pasting the whole JSON).
#
# Empty / unset means "use whatever's in DEPLOYMENT_V7_<chainId>".

# arb-sepolia (421614)
TEZCATLI_VAULT_V7_421614=
TEZCATLI_ADAPTER_V7_421614=

# base-sepolia (84532)
TEZCATLI_VAULT_V7_84532=
TEZCATLI_ADAPTER_V7_84532=

# eth-sepolia (11155111)
TEZCATLI_VAULT_V7_11155111=
TEZCATLI_ADAPTER_V7_11155111=


