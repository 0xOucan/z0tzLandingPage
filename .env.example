# ═══ 5. V6.5 indexer per-chain ══════════════════════════════════════════
#
# These power the V6.5 history indexer (separate code path from the
# relayer). Same addresses as section 4 but with INDEXER_ prefix —
# decoupled so the indexer can point at a different deployment if you
# ever need to reindex from a fresh fork. Set to the same values as
# section 4 unless you have a specific reason to diverge.

INDEXER_ACCOUNT_FACTORY_ADDRESS_11155111=0xE6eD73e9dB832bFd7e80432E36A4b187999EC3F7
INDEXER_ENTRY_POINT_ADDRESS_11155111=0x4337084D9E255Ff0702461CF8895CE9E3b5Ff108
INDEXER_LEDGER_ADDRESS_11155111=0x...
INDEXER_PAYMASTER_ADDRESS_11155111=0xfB2Fa879726c9e1101497D4F9B34BdD1ec0c8702
INDEXER_SWEEPER_ADDRESS_11155111=0x...
INDEXER_VAULT_ADDRESS_11155111=0x...

INDEXER_ACCOUNT_FACTORY_ADDRESS_421614=0xdC2C1240688D7Ec45B91662541D3a1E249a06359
INDEXER_ENTRY_POINT_ADDRESS_421614=0x4337084D9E255Ff0702461CF8895CE9E3b5Ff108
INDEXER_LEDGER_ADDRESS_421614=0x...
INDEXER_PAYMASTER_ADDRESS_421614=0x4B038D34809363174a6Fc44715CE8Aafc1f9c55d
INDEXER_SWEEPER_ADDRESS_421614=0x...
INDEXER_VAULT_ADDRESS_421614=0x...

INDEXER_ACCOUNT_FACTORY_ADDRESS_84532=0x01E543EF0dC63328Ef59250dA4cBc717BBf7bAb3
INDEXER_ENTRY_POINT_ADDRESS_84532=0x4337084D9E255Ff0702461CF8895CE9E3b5Ff108
INDEXER_LEDGER_ADDRESS_84532=0x...
INDEXER_PAYMASTER_ADDRESS_84532=0xd32aD7E3D879458963762B432edEc4D04E77A976
INDEXER_SWEEPER_ADDRESS_84532=0x...
INDEXER_VAULT_ADDRESS_84532=0x...


# ═══ 6. Turso (libsql) — TWO databases ══════════════════════════════════
#
# V6.5 and V7 use SEPARATE databases. V6.5 stays frozen on the existing
# DB; V7 gets a fresh DB so the schema can evolve without touching
# v6.5-stable consumers.
#
# Within each generation, ONE database covers all chains
# (every table has chain_id columns).
#
# Local dev: use file:./local.db (no Turso account needed).
# Production: provision at https://turso.tech, get the libsql:// URL
#             and an auth token via `turso db tokens create z0tz-...`

# V6.5 (existing, frozen)
TURSO_DATABASE_URL=libsql://z0tz-v65-<org>.turso.io
TURSO_AUTH_TOKEN=<paste-from-turso-CLI-mark-sensitive>

# V7 (new)
TURSO_V7_DATABASE_URL=libsql://z0tz-v7-<org>.turso.io
TURSO_V7_AUTH_TOKEN=<paste-from-turso-CLI-mark-sensitive>


# ═══ 7. V7 — paymaster cosign policy ════════════════════════════════════

# Max wei the operator will sponsor in any single UserOp.
# Default 1 ETH = 1e18 wei.
Z0TZ_PAYMASTER_MAX_FEE_CAP=1000000000000000000

# Max validity window for a single cosign sig (seconds).
# Default 600 (10 min). Don't set high — long-lived cosigns invite replay.
Z0TZ_PAYMASTER_MAX_VALIDITY=600


# ═══ 8. Abuse / geo / audit-log ═════════════════════════════════════════

# Geo-block. "true" in production; "false" or unset on dev.
GEOFENCE_ENABLED=true

# Optional override for default-blocked country list.
# GEOFENCE_BLOCKED_COUNTRIES=US,CA,IR,KP,SY,CU

# Random 32-character salt used to hash IPs before logging.
# Rotate per environment (dev/staging/prod) so logs can't be cross-correlated.
Z0TZ_IP_HASH_SALT=<random-32-hex-chars>


# ═══ 9. Indexer budget + Etherscan ══════════════════════════════════════

# Per-call soft deadline for /api/v7/scan (V7) and /api/index/trigger (V6.5).
# Hobby tier: 52000 (52s). Pro tier: bump to 280000 if maxDuration=300.
INDEXER_MAX_MS=52000

# Optional: Etherscan V2 API key. Speeds up indexer; falls back to RPC pool
# if absent. Required for >1k log queries.
ETHERSCAN_API_KEY=


# ═══ 10. Quotes + rate limits + DeFi caps (V6.5 routes) ═════════════════

MAX_OPS_PER_MINUTE=60
ETH_USD_FALLBACK=3000
FUND_STEALTH_LIMIT=100
QUOTE_BASE_FEE_BPS=50
QUOTE_OVERHEAD_MARKUP=0.1
QUOTE_FALLBACK_USDC_MICROS_LEDGER_OP=200000
QUOTE_FALLBACK_USDC_MICROS_LEDGER_SWEEP=300000
QUOTE_FALLBACK_USDC_MICROS_FUND_STEALTH=200000
QUOTE_FALLBACK_USDC_MICROS_RELAY=250000
QUOTE_FALLBACK_USDC_MICROS_BRIDGE=400000
QUOTE_FALLBACK_USDC_MICROS_PRIVATE_BRIDGE=500000
QUOTE_FALLBACK_USDC_MICROS_STRATEGY_DEPLOY=350000
QUOTE_FALLBACK_USDC_MICROS_STRATEGY_REDEEM=350000
STRATEGY_DEPLOY_CAP=1000000000
STRATEGY_DEPLOY_THRESHOLD=10000000
STRATEGY_DEPLOY_SLIPPAGE_BPS=50
STRATEGY_DEPLOY_REQUIRE_AUTH=true
STRATEGY_REDEEM_BUFFER_BPS=20
STRATEGY_REDEEM_SLIPPAGE_BPS=50
STRATEGY_REDEEM_REQUIRE_AUTH=true


# ═══════════════════════════════════════════════════════════════════════
# Vercel deployment notes
# ═══════════════════════════════════════════════════════════════════════
#
# Mark these "Sensitive" in the Vercel dashboard so they're encrypted at
# rest and hidden from deploy logs:
#   RELAYER_PRIVATE_KEY
#   TURSO_AUTH_TOKEN
#   TURSO_V7_AUTH_TOKEN
#   ETHERSCAN_API_KEY (if used)
#   RELAYER_BYPASS_TOKEN (if used)
#
# Apply to "Production" environment only — don't apply secrets to Preview
# (they'd appear on every PR's preview deployment).
#
# vercel.json at the project root configures crons that hit /api/v7/scan
# every 10 minutes per chain as a fallback indexer trigger. Active users
# trigger scan themselves via the SDK / GUI / APK before reading history.
