{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm run build",
  "functions": {
    "app/api/v7/scan/route.ts": {
      "maxDuration": 10
    },
    "app/api/v7/cashin/route.ts": {
      "maxDuration": 30
    },
    "app/api/v7/spend/route.ts": {
      "maxDuration": 30
    },
    "app/api/v7/airdrop/route.ts": {
      "maxDuration": 30
    },
    "app/api/v7/recover/route.ts": {
      "maxDuration": 30
    },
    "app/api/v7/names/route.ts": {
      "maxDuration": 30
    },
    "app/api/v7/paymaster/cosign/route.ts": {
      "maxDuration": 15
    },
    "app/api/v7/tezcatli/cashin-cosign/route.ts": {
      "maxDuration": 15
    },
    "app/api/v7/tezcatli/cashout-cosign/route.ts": {
      "maxDuration": 15
    }
  },
  "crons": [
    { "path": "/api/v7/scan?chainId=421614", "schedule": "* * * * *" },
    { "path": "/api/v7/scan?chainId=84532", "schedule": "* * * * *" },
    { "path": "/api/v7/scan?chainId=11155111", "schedule": "*/2 * * * *" }
  ]
}
