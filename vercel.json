{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm run build",
  "functions": {
    "app/api/v7/scan/route.ts": {
      "maxDuration": 60
    },
    "app/api/v7/cashin/route.ts": {
      "maxDuration": 30
    },
    "app/api/v7/spend/route.ts": {
      "maxDuration": 30
    },
    "app/api/v7/airdrop/route.ts": {
      "maxDuration": 30
    },
    "app/api/v7/recover/route.ts": {
      "maxDuration": 30
    },
    "app/api/v7/names/route.ts": {
      "maxDuration": 30
    },
    "app/api/v7/paymaster/cosign/route.ts": {
      "maxDuration": 15
    },
    "app/api/v7/tezcatli/cashin-cosign/route.ts": {
      "maxDuration": 15
    },
    "app/api/v7/tezcatli/cashout-cosign/route.ts": {
      "maxDuration": 15
    }
  }
}
